{
  "name": "suite-educative",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter zachart-mentale dev",
    "build": "bun run --filter zachart-mentale build",
    "tauri": "bun run --filter zachart-mentale tauri",
    "test": "bun run --filter '*' test",
    "test:admin": "cd apps/zachart-mentale/admin && bun run test",
    "test:all": "bun run test && bun run test:admin && bun run test:infra && bun run test:scripts",
    "test:infra": "bun apps/zachart-mentale/node_modules/vitest/vitest.mjs run --root infra",
    "admin:dev": "cd apps/zachart-mentale/admin && bun run dev",
    "admin:build": "cd apps/zachart-mentale/admin && bun run build",
    "infra:check": "bun run infra/setup-pocketbase.mjs --check",
    "infra:plan": "bun run infra/setup-pocketbase.mjs --dry-run",
    "infra:apply": "bun run infra/setup-pocketbase.mjs",
    "deploy": "bun scripts/deploy.mjs",
    "version:bump": "bun scripts/bump-version.mjs",
    "update:mentale": "bun scripts/make-update.mjs mentale",
    "update:maths": "bun scripts/make-update.mjs maths",
    "update:all": "bun scripts/make-update.mjs all",
    "new-app": "bun scripts/new-app.mjs",
    "measure:sharing": "bun scripts/measure-sharing.mjs",
    "test:scripts": "bun test scripts"
  }
}

import Hero from '../site/Hero.astro'
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Zachar’t — cartes mentales et exercices pour réviser</title>
    <meta
      name="description"
      content="Zachar’t : la suite d’outils pour réviser avec des cartes mentales et des fiches d’exercices, pensée pour les élèves et leurs professeurs."
    />
  </head>
  <body>

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zach'Math",
  "version": "0.2.0",
  "identifier": "com.clape.zachart-maths",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1450",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zach'Math",
        "width": 1200,
        "height": 900,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
